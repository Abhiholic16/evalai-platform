# Safe default: local digital-PDF text extraction only. Scanned handwriting stays blank.
EVALAI_OCR_PROVIDER=demo
EVALAI_EVALUATION_PROVIDER=demo
EVALAI_EMAIL_PROVIDER=simulation

# Faculty access is required at startup; replace both values in your private .env.
EVALAI_FACULTY_USERNAME=
EVALAI_FACULTY_PASSWORD=
EVALAI_SESSION_SECRET=
# Set true when HTTPS is enabled (required for production).
EVALAI_COOKIE_SECURE=false

# Optional: only when you explicitly choose OpenAI vision and configure a key privately.
# Uploaded page images are sent to the selected provider for transcription.
# EVALAI_OCR_PROVIDER=openai
# OPENAI_API_KEY=
# EVALAI_VISION_MODEL=gpt-4.1-mini
# EVALAI_EVALUATION_PROVIDER=openai
# EVALAI_EVALUATION_MODEL=gpt-4.1-mini

# Optional: actual email is sent only when SMTP is explicitly selected.
# EVALAI_EMAIL_PROVIDER=smtp
# EVALAI_SMTP_HOST=
# EVALAI_SMTP_PORT=587
# EVALAI_SMTP_USERNAME=
# EVALAI_SMTP_PASSWORD=
# EVALAI_EMAIL_FROM=

# Optional. Defaults to backend/uploads; keep uploaded student files outside source control.
# EVALAI_UPLOAD_DIR=
